generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  active        Boolean          @default(true)
  hasDesigner   Boolean          @default(true)
  brand         String           @default("roi") // "roi" | "nitroads"
  // Campos admin-only
  ticket        Float?           // Ticket mensal (R$)
  contractDate  DateTime?        // Data de contratação
  services      String?          // JSON: ["Tráfego", "Criativos", ...]
  createdAt     DateTime         @default(now())
  deletedAt     DateTime?        // Soft delete: preserva histórico de NPS/financeiro, oculto das listagens
  responses     NpsResponse[]
  operators     ClientOperator[]
  observations  ClientObservation[]
  links         ClientLink[]
}

model Collaborator {
  id                String           @id @default(cuid())
  name              String
  role              String           // "gestor_trafego" | "designer"
  active            Boolean          @default(true)
  // Dados pessoais (preenchidos pela própria pessoa no Painel Pessoal)
  fullName          String?          // Nome completo
  birthDate         DateTime?        // Data de nascimento
  cpf               String?
  cnpj              String?
  avatarUrl         String?          // foto do perfil (data URL base64)
  // Campos admin-only
  salary            Float?           // Salário base (R$)
  variable          Float?           // Variável/comissão (R$)
  hireDate          DateTime?        // Data de entrada
  deletedAt         DateTime?        // Soft delete: preserva histórico de avaliações, oculto das listagens
  trafegoResponses  NpsResponse[]    @relation("TrafegoCollab")
  designerResponses NpsResponse[]    @relation("DesignerCollab")
  clientPortfolio   ClientOperator[]
  adminUser         AdminUser?
  cardsAssigned     BoardCard[]      @relation("CardAssignee")
  cardsCoAssigned   BoardCard[]      @relation("CardCoAssignee")
  observations      ClientObservation[]
}

// Relação explícita: quais clientes cada operador gerencia
model ClientOperator {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])
  assignedAt     DateTime     @default(now())

  @@unique([clientId, collaboratorId])
}

model NpsResponse {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  month          String        // "2025-07"
  trafegoScore   Int
  trafegoCollab  String?
  trafego        Collaborator? @relation("TrafegoCollab", fields: [trafegoCollab], references: [id])
  designerScore  Int?
  designerCollab String?
  designer       Collaborator? @relation("DesignerCollab", fields: [designerCollab], references: [id])
  feedback       String?
  submittedAt    DateTime      @default(now())
}

model AdminUser {
  id             String        @id @default(cuid())
  email          String        @unique
  password       String?       // null = login apenas via Google (SSO)
  role           String        @default("admin") // "admin" | "operator"
  collaboratorId String?       @unique
  collaborator   Collaborator? @relation(fields: [collaboratorId], references: [id])
}

// ============================================================================
// Boards — Kanban estilo ClickUp para gestão de tarefas internas
// ============================================================================

model Board {
  id        String      @id @default(cuid())
  name      String
  team      String?     // Ex: "Marketing / Design"
  color     String      @default("#F59E0B") // cor de destaque do board
  prefix    String      @default("TASK")    // prefixo do código dos cards (ex: "MAR")
  cardSeq   Int         @default(0)          // contador para gerar códigos sequenciais
  createdAt DateTime    @default(now())
  deletedAt DateTime?
  cards     BoardCard[]
  tags      BoardTag[]
}

model BoardTag {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  color   String      @default("#7C1EFB")
  cards   BoardCard[]

  @@unique([boardId, name])
}

model BoardCard {
  id           String   @id @default(cuid())
  boardId      String
  board        Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  code         String   // "MAR-127"
  title        String
  description  String?
  // backlog | todo | doing | review | blocked | done
  status       String   @default("backlog")
  priority     String?  // baixa | media | alta
  order        Float    @default(0) // ordenação dentro da coluna

  assigneeId   String?
  assignee     Collaborator? @relation("CardAssignee", fields: [assigneeId], references: [id])
  coAssigneeId String?
  coAssignee   Collaborator? @relation("CardCoAssignee", fields: [coAssigneeId], references: [id])
  createdByName  String?
  createdByEmail String?

  tagId    String?
  tag      BoardTag? @relation(fields: [tagId], references: [id])

  startDate DateTime?
  dueDate   DateTime?

  parentId String?     // se preenchido, este card é subtarefa de outro
  parent   BoardCard?  @relation("Subtasks", fields: [parentId], references: [id])
  subtasks BoardCard[] @relation("Subtasks")

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  checklist     CardChecklistItem[]
  attachments   CardAttachment[]
  comments      CardComment[]
  activities    CardActivity[]
  relationsFrom CardRelation[]      @relation("RelFrom")
  relationsTo   CardRelation[]      @relation("RelTo")

  @@index([boardId])
  @@index([parentId])
}

model CardChecklistItem {
  id     String    @id @default(cuid())
  cardId String
  card   BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text   String
  done   Boolean   @default(false)
  order  Float     @default(0)
}

model CardAttachment {
  id        String    @id @default(cuid())
  cardId    String
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  dataUrl   String    // data URL base64 (limitado a ~1.5MB por arquivo)
  createdAt DateTime  @default(now())
}

model CardComment {
  id          String    @id @default(cuid())
  cardId      String
  card        BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  body        String
  createdAt   DateTime  @default(now())
}

// Timeline do card — log de atividades
model CardActivity {
  id        String    @id @default(cuid())
  cardId    String
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actorName String
  type      String    // created | status | assignee | due | tag | title | comment | attachment | checklist | relation | subtask
  detail    String?
  createdAt DateTime  @default(now())

  @@index([cardId])
}

model CardRelation {
  id     String    @id @default(cuid())
  fromId String
  from   BoardCard @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     BoardCard @relation("RelTo", fields: [toId], references: [id], onDelete: Cascade)
  // relacionado | bloqueia | bloqueado_por | duplica
  type   String    @default("relacionado")

  @@unique([fromId, toId, type])
}

// Observação privada do operador sobre um cliente (só o próprio operador vê).
model ClientObservation {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  note           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([clientId, collaboratorId])
}

// Links úteis por cliente (ex: pasta do logo do cliente). Gerenciado pelo admin,
// visível para quem tem o cliente na carteira.
model ClientLink {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String
  url       String
  order     Float    @default(0)
  createdAt DateTime @default(now())

  @@index([clientId])
}
